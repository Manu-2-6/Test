<Window x:Class="SoftwareSetupApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SoftwareSetupApp"
        xmlns:converters="clr-namespace:SoftwareSetupApp.Converters"
        xmlns:models="clr-namespace:SoftwareSetupApp.Models"
        mc:Ignorable="d"
        Title="Post-installation Setup" Height="500" Width="680"
        MinWidth="620" MinHeight="420">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:NameInitialConverter x:Key="NameInitialConverter" />
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Vertical" Grid.Row="0" Margin="0 0 0 16">
            <TextBlock Text="Préparez votre poste en installant les applications essentielles." FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="Sélectionnez les logiciels à installer via winget puis cliquez sur &quot;Installer&quot;." Margin="0 6 0 0" />
        </StackPanel>

        <TabControl Grid.Row="1">
            <TabItem Header="Applications">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="12" CornerRadius="8" Background="#F4F6FB" BorderBrush="#D0D6E2" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <CheckBox x:Name="SelectAllCheckBox"
                                      Grid.Row="0"
                                      Content="Tout sélectionner"
                                      Margin="0 0 0 8"
                                      IsThreeState="True"
                                      Click="SelectAllCheckBox_Click" />
                            <ListView x:Name="PackagesList"
                                      Grid.Row="1"
                                      ItemsSource="{Binding Packages}"
                                      BorderThickness="0"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.Resources>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="4" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListView.Resources>
                                <ListView.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:SoftwarePackage}">
                                        <Grid Margin="0 4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="220" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Margin="0" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          VerticalAlignment="Center"
                                                          Margin="0 0 12 0" />
                                                <Grid Grid.Column="1"
                                                      Width="32"
                                                      Height="32"
                                                      Margin="0 0 12 0"
                                                      VerticalAlignment="Center">
                                                    <Image Width="32"
                                                           Height="32"
                                                           Stretch="Uniform"
                                                           Source="{Binding LogoPath}">
                                                        <Image.Style>
                                                            <Style TargetType="Image">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasLogo}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Image.Style>
                                                    </Image>
                                                    <Border CornerRadius="8"
                                                            Background="#E0E3EB"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasLogo}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding Name, Converter={StaticResource NameInitialConverter}}"
                                                                   FontWeight="SemiBold"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="#425066" />
                                                    </Border>
                                                </Grid>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding Name}"
                                                           VerticalAlignment="Center"
                                                           FontWeight="SemiBold"
                                                           Foreground="#1F2933" />
                                            </Grid>
                                            <Grid Grid.Column="1"
                                                  Margin="12 0 0 0"
                                                  VerticalAlignment="Center">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid Grid.Row="0"
                                                      Height="20"
                                                      VerticalAlignment="Center"
                                                      Visibility="{Binding IsProgressVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <ProgressBar Minimum="0"
                                                                 Maximum="100"
                                                                 Value="{Binding Progress}"
                                                                 Height="20"
                                                                 VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Progress, StringFormat={}{0}%}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontWeight="SemiBold"
                                                               Foreground="#1F2933" />
                                                </Grid>
                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding Status}"
                                                           HorizontalAlignment="Right"
                                                           Margin="0 4 0 0"
                                                           Foreground="#2F73DA" />
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 16 0 16">
                        <Button x:Name="CancelButton"
                                Content="Annuler"
                                Width="140"
                                Height="36"
                                Margin="0 0 12 0"
                                IsEnabled="False"
                                Click="CancelButton_Click" />
                        <Button x:Name="InstallButton" Content="Installer" Width="140" Height="36" Click="InstallButton_Click" />
                    </StackPanel>

                    <Border Grid.Row="2" Padding="12" CornerRadius="8" Background="#FFFFFF" BorderBrush="#D0D6E2" BorderThickness="1">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0 0 0 8" LastChildFill="False">
                                <TextBlock Text="Journal"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <Button x:Name="CopyLogButton"
                                        Content="Copier le journal"
                                        Margin="12 0 0 0"
                                        Padding="12 4"
                                        Click="CopyLogButton_OnClick"
                                        VerticalAlignment="Center" />
                            </DockPanel>
                            <ListBox x:Name="LogListBox"
                                     ItemsSource="{Binding Logs}"
                                     BorderThickness="0"
                                     Background="#FF000000"
                                     Foreground="#FFFFFFFF"
                                     MinHeight="180"
                                     Loaded="LogListBox_OnLoaded"
                                     Unloaded="LogListBox_OnUnloaded" />
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Checklist">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Vertical" Margin="0 0 0 12">
                        <TextBlock Text="Adaptez la checklist en fonction du poste à préparer." FontWeight="SemiBold" Margin="0 0 0 12" />
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Width="220" Margin="0 0 24 0">
                                <TextBlock Text="Type d'ordinateur" FontWeight="SemiBold" Margin="0 0 0 4" />
                                <ComboBox ItemsSource="{Binding DeviceTypeOptions}"
                                          SelectedValuePath="Value"
                                          DisplayMemberPath="DisplayName"
                                          SelectedValue="{Binding SelectedDeviceType, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel Width="220">
                                <TextBlock Text="Profil utilisateur" FontWeight="SemiBold" Margin="0 0 0 4" />
                                <ComboBox ItemsSource="{Binding UserProfileOptions}"
                                          SelectedValuePath="Value"
                                          DisplayMemberPath="DisplayName"
                                          SelectedValue="{Binding SelectedUserProfile, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding TasksView}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:SetupTask}">
                                    <Border Margin="0 0 0 12"
                                            Padding="12"
                                            CornerRadius="8"
                                            Background="#F9FAFB"
                                            BorderBrush="#D0D6E2"
                                            BorderThickness="1">
                                        <StackPanel>
                                            <CheckBox IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                                                      FontWeight="SemiBold">
                                                <TextBlock Text="{Binding Title}"
                                                           TextWrapping="Wrap" />
                                            </CheckBox>
                                            <TextBlock Text="{Binding Details}"
                                                       Margin="28 4 0 0"
                                                       TextWrapping="Wrap"
                                                       Foreground="#374151">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Details}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Details}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
