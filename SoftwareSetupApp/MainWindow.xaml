<Window x:Class="SoftwareSetupApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SoftwareSetupApp"
        xmlns:converters="clr-namespace:SoftwareSetupApp.Converters"
        xmlns:models="clr-namespace:SoftwareSetupApp.Models"
        mc:Ignorable="d"
        Title="Post-installation W11 Setup" Height="500" Width="680"
        MinWidth="620" MinHeight="420"
        UseLayoutRounding="True"
        Icon="/SoftwareSetupApp;component/Assets/Logos/Amix.png">
    <Window.Resources>
        <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F5F7FF" Offset="0" />
            <GradientStop Color="#E9ECF8" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#4F46E5" />
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#4338CA" />
        <SolidColorBrush x:Key="PrimaryForegroundBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="AccentBrush" Color="#10B981" />
        <SolidColorBrush x:Key="NeutralForegroundBrush" Color="#1F2937" />
        <SolidColorBrush x:Key="MutedForegroundBrush" Color="#4B5563" />
        <SolidColorBrush x:Key="SubtleBorderBrush" Color="#E5E7EB" />
        <SolidColorBrush x:Key="TabInactiveBrush" Color="#E0E7FF" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:NameInitialConverter x:Key="NameInitialConverter" />
        <converters:StringNotNullOrEmptyToVisibilityConverter x:Key="StringNotNullOrEmptyToVisibilityConverter" />

        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="16 8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundedButtonStyle}">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundedButtonStyle}">
            <Setter Property="Background" Value="#EEF2FF" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style x:Key="GhostButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundedButtonStyle}">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="Padding" Value="14 6" />
        </Style>

        <Style x:Key="TogglePillStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{StaticResource TabInactiveBrush}" />
            <Setter Property="Foreground" Value="{StaticResource NeutralForegroundBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="12 6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#D1D9FF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryForegroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="16 8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="border"
                                Background="Transparent"
                                CornerRadius="10"
                                Margin="4 0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="contentPresenter"
                                              ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFFFFFFF" />
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                <Setter TargetName="border" Property="BorderThickness" Value="1" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F3F4FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListView">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Border Margin="24"
                Padding="24"
                CornerRadius="18"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource SubtleBorderBrush}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.18" Color="#2D3748" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="3*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2*" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal"
                            Grid.Row="0"
                            Margin="0 0 0 16"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Image Source="/SoftwareSetupApp;component/Assets/Logos/Amix.png"
                           Width="140"
                           Height="140"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           SnapsToDevicePixels="True" />
                </StackPanel>

                <TabControl Grid.Row="1" Margin="0">
                    <TabItem Header="Programmes">
                        <Border Padding="16" CornerRadius="14" Background="#F8FAFF" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <CheckBox x:Name="ProgramsSelectAllCheckBox"
                                          Grid.Row="0"
                                          Content="Tout sélectionner"
                                          Margin="0 0 0 12"
                                          IsThreeState="True"
                                          Foreground="{StaticResource MutedForegroundBrush}"
                                          Click="ProgramsSelectAllCheckBox_Click" />
                                <ListView x:Name="PackagesList"
                                          Grid.Row="1"
                                          ItemsSource="{Binding Packages}"
                                          BorderThickness="0"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListView.Resources>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="Padding" Value="4" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </ListView.Resources>
                                    <ListView.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:SoftwarePackage}">
                                            <Grid Margin="0 6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="220" />
                                                </Grid.ColumnDefinitions>
                                                <Grid Margin="0" VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Grid.Column="0"
                                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                              VerticalAlignment="Center"
                                                              Margin="0 0 12 0"
                                                              Foreground="{StaticResource NeutralForegroundBrush}" />
                                                    <Grid Grid.Column="1"
                                                          Width="32"
                                                          Height="32"
                                                          Margin="0 0 12 0"
                                                          VerticalAlignment="Center">
                                                        <Image Width="32"
                                                               Height="32"
                                                               Stretch="Uniform"
                                                               RenderOptions.BitmapScalingMode="HighQuality"
                                                               SnapsToDevicePixels="True"
                                                               Source="{Binding LogoPath}">
                                                            <Image.Style>
                                                                <Style TargetType="Image">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasLogo}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Image.Style>
                                                        </Image>
                                                        <Border CornerRadius="8"
                                                                Background="#E8ECF5"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasLogo}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding Name, Converter={StaticResource NameInitialConverter}}"
                                                                       FontWeight="SemiBold"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{StaticResource MutedForegroundBrush}" />
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding Name}"
                                                               VerticalAlignment="Center"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource NeutralForegroundBrush}" />
                                                </Grid>
                                                <Grid Grid.Column="1"
                                                      Margin="12 0 0 0"
                                                      VerticalAlignment="Center">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid Grid.Row="0"
                                                          Height="20"
                                                          VerticalAlignment="Center"
                                                          Visibility="{Binding IsProgressVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <ProgressBar Minimum="0"
                                                                     Maximum="100"
                                                                     Value="{Binding Progress}"
                                                                     Height="20"
                                                                     Foreground="{StaticResource AccentBrush}"
                                                                     Background="#E5E7EB"
                                                                     VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Progress, StringFormat={}{0}%}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource NeutralForegroundBrush}" />
                                                    </Grid>
                                                    <TextBlock Grid.Row="1"
                                                               Text="{Binding Status}"
                                                               HorizontalAlignment="Right"
                                                               Margin="0 4 0 0"
                                                               Foreground="{StaticResource PrimaryBrush}" />
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>
                    </TabItem>
                    <TabItem Header="Paramétrage Windows">
                        <Border Padding="16" CornerRadius="14" Background="#F8FAFF" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0"
                                            Orientation="Horizontal"
                                            Margin="0 0 0 12">
                                    <CheckBox x:Name="TasksSelectAllCheckBox"
                                              Content="Tout sélectionner"
                                              IsThreeState="True"
                                              Foreground="{StaticResource MutedForegroundBrush}"
                                              Click="TasksSelectAllCheckBox_Click" />
                                    <CheckBox x:Name="ProModeCheckBox"
                                              Content="Pro"
                                              Margin="12 0 0 0"
                                              VerticalAlignment="Center"
                                              Foreground="{StaticResource MutedForegroundBrush}"
                                              IsChecked="{Binding IsProfessionalMode, Mode=TwoWay}" />
                                </StackPanel>
                                <ListView x:Name="TasksList"
                                          Grid.Row="1"
                                          ItemsSource="{Binding ConfigurationTasks}"
                                          BorderThickness="0"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListView.Resources>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="Padding" Value="4" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </ListView.Resources>
                                    <ListView.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:ConfigurationTask}">
                                            <Grid Margin="0 6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="220" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="0">
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                              VerticalAlignment="Center"
                                                              Margin="0 0 12 0"
                                                              Foreground="{StaticResource NeutralForegroundBrush}" />
                                                    <StackPanel Orientation="Vertical">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource NeutralForegroundBrush}"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Description}"
                                                                   Foreground="{StaticResource MutedForegroundBrush}"
                                                                   FontStyle="Italic"
                                                                   Margin="0 2 0 0"
                                                                   TextWrapping="Wrap"
                                                                   Visibility="{Binding Description, Converter={StaticResource StringNotNullOrEmptyToVisibilityConverter}}" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Status}"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource PrimaryBrush}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>
                    </TabItem>
                    <TabItem Header="A faire manuellement">
                        <Border Padding="16" CornerRadius="14" Background="#F8FAFF" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Margin="0 0 0 12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="OpenWindowsToolsButton"
                                                Grid.Column="0"
                                                Content="Ouvrir les fenêtres Windows"
                                                Padding="16 6"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Click="OpenWindowsToolsButton_Click" />
                                        <ToggleButton x:Name="WindowsToolsToggleButton"
                                                      Grid.Column="1"
                                                      Width="36"
                                                      Margin="8 0 0 0"
                                                      Content="▼"
                                                      Style="{StaticResource TogglePillStyle}"
                                                      ClickMode="Press"
                                                      Checked="WindowsToolsToggleButton_OnChecked"
                                                      Unchecked="WindowsToolsToggleButton_OnUnchecked" />
                                    </Grid>
                                    <Popup x:Name="WindowsToolsPopup"
                                           PlacementTarget="{Binding ElementName=WindowsToolsToggleButton}"
                                           Placement="Bottom"
                                           AllowsTransparency="True"
                                           StaysOpen="False"
                                           PopupAnimation="Fade"
                                           DataContext="{Binding DataContext, ElementName=OpenWindowsToolsButton}"
                                           Closed="WindowsToolsPopup_OnClosed">
                                        <Border Background="#FFFFFFFF"
                                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Padding="16">
                                            <StackPanel>
                                                <CheckBox Content="Tout sélectionner"
                                                          Margin="0 0 0 8"
                                                          IsThreeState="True"
                                                          Foreground="{StaticResource MutedForegroundBrush}"
                                                          IsChecked="{Binding AreAllWindowsToolsSelected, Mode=TwoWay}" />
                                                <Separator Margin="0 0 0 8" />
                                                <ItemsControl ItemsSource="{Binding ManualWindowsTools}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type models:ManualWindowsTool}">
                                                            <CheckBox Content="{Binding Name}"
                                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                      Margin="0 4 0 0"
                                                                      Foreground="{StaticResource NeutralForegroundBrush}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </StackPanel>

                                <ListView x:Name="ManualTasksList"
                                          Grid.Row="1"
                                          ItemsSource="{Binding ManualTasks}"
                                          BorderThickness="0"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListView.Resources>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="Padding" Value="4" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </ListView.Resources>
                                    <ListView.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:ManualTask}">
                                            <Border Padding="12"
                                                    CornerRadius="10"
                                                    Background="#FFFFFFFF"
                                                    BorderBrush="{StaticResource SubtleBorderBrush}"
                                                    BorderThickness="1">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#FFFFFFFF" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                <Setter Property="Background" Value="#ECFDF5" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <CheckBox IsChecked="{Binding IsCompleted, Mode=TwoWay}" VerticalAlignment="Top"
                                                          Foreground="{StaticResource NeutralForegroundBrush}">
                                                    <CheckBox.Content>
                                                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" Foreground="{StaticResource NeutralForegroundBrush}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{StaticResource NeutralForegroundBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                            <Setter Property="TextDecorations" Value="Strikethrough" />
                                                                            <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </CheckBox.Content>
                                                </CheckBox>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>
                    </TabItem>
                </TabControl>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 24 0 24">
                    <Button x:Name="CancelButton"
                            Content="Annuler"
                            Width="140"
                            Height="40"
                            Margin="0 0 12 0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            IsEnabled="False"
                            Click="CancelButton_Click" />
                    <Button x:Name="InstallButton"
                            Content="Installer"
                            Width="160"
                            Height="44"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="InstallButton_Click" />
                </StackPanel>

                <Border Grid.Row="3" Padding="16" CornerRadius="14" Background="#0F172A" BorderBrush="Transparent" BorderThickness="1">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0 0 0 8" LastChildFill="False">
                            <TextBlock Text="Journal"
                                       FontWeight="SemiBold"
                                       Foreground="#E2E8F0"
                                       VerticalAlignment="Center" />
                            <Button x:Name="CopyLogButton"
                                    Content="Copier le journal"
                                    Margin="12 0 0 0"
                                    Padding="12 4"
                                    Style="{StaticResource GhostButtonStyle}"
                                    Click="CopyLogButton_OnClick"
                                    VerticalAlignment="Center" />
                        </DockPanel>
                        <ListBox x:Name="LogListBox"
                                 ItemsSource="{Binding Logs}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="#F8FAFC"
                                 MinHeight="180"
                                 Loaded="LogListBox_OnLoaded"
                                 Unloaded="LogListBox_OnUnloaded" />
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
