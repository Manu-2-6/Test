<Window x:Class="SoftwareSetupApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SoftwareSetupApp"
        xmlns:converters="clr-namespace:SoftwareSetupApp.Converters"
        xmlns:models="clr-namespace:SoftwareSetupApp.Models"
        mc:Ignorable="d"
        Title="Post-installation Setup" Height="500" Width="680"
        MinWidth="620" MinHeight="420">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:NameInitialConverter x:Key="NameInitialConverter" />
        <converters:StringNotNullOrEmptyToVisibilityConverter x:Key="StringNotNullOrEmptyToVisibilityConverter" />
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Vertical" Grid.Row="0" Margin="0 0 0 16">
            <StackPanel Orientation="Horizontal"
                        Margin="0 0 0 12"
                        VerticalAlignment="Center">
                <Image Source="/SoftwareSetupApp;component/Assets/Logos/Amix.jpg"
                       Width="80"
                       Height="80"
                       Stretch="Uniform"
                       SnapsToDevicePixels="True" />
            </StackPanel>
            <TextBlock Text="Sélectionnez les logiciels winget ou les tâches Windows à appliquer puis cliquez sur &quot;Installer&quot;." Margin="0 6 0 0" />
        </StackPanel>

        <TabControl Grid.Row="1" Margin="0">
            <TabItem Header="Programmes">
                <Border Padding="12" CornerRadius="8" Background="#F4F6FB" BorderBrush="#D0D6E2" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <CheckBox x:Name="ProgramsSelectAllCheckBox"
                                  Grid.Row="0"
                                  Content="Tout sélectionner"
                                  Margin="0 0 0 8"
                                  IsThreeState="True"
                                  Click="ProgramsSelectAllCheckBox_Click" />
                        <ListView x:Name="PackagesList"
                                  Grid.Row="1"
                                  ItemsSource="{Binding Packages}"
                                  BorderThickness="0"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.Resources>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="4" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.Resources>
                            <ListView.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:SoftwarePackage}">
                                    <Grid Margin="0 4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="220" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Margin="0" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      VerticalAlignment="Center"
                                                      Margin="0 0 12 0" />
                                            <Grid Grid.Column="1"
                                                  Width="32"
                                                  Height="32"
                                                  Margin="0 0 12 0"
                                                  VerticalAlignment="Center">
                                                <Image Width="32"
                                                       Height="32"
                                                       Stretch="Uniform"
                                                       Source="{Binding LogoPath}">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasLogo}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>
                                                <Border CornerRadius="8"
                                                        Background="#E0E3EB"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasLogo}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Name, Converter={StaticResource NameInitialConverter}}"
                                                               FontWeight="SemiBold"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="#425066" />
                                                </Border>
                                            </Grid>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Name}"
                                                       VerticalAlignment="Center"
                                                       FontWeight="SemiBold"
                                                       Foreground="#1F2933" />
                                        </Grid>
                                        <Grid Grid.Column="1"
                                              Margin="12 0 0 0"
                                              VerticalAlignment="Center">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0"
                                                  Height="20"
                                                  VerticalAlignment="Center"
                                                  Visibility="{Binding IsProgressVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <ProgressBar Minimum="0"
                                                             Maximum="100"
                                                             Value="{Binding Progress}"
                                                             Height="20"
                                                             VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Progress, StringFormat={}{0}%}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontWeight="SemiBold"
                                                           Foreground="#1F2933" />
                                            </Grid>
                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding Status}"
                                                       HorizontalAlignment="Right"
                                                       Margin="0 4 0 0"
                                                       Foreground="#2F73DA" />
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </TabItem>
            <TabItem Header="Paramétrage Windows">
                <Border Padding="12" CornerRadius="8" Background="#F4F6FB" BorderBrush="#D0D6E2" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0"
                                    Orientation="Horizontal"
                                    Margin="0 0 0 8">
                            <CheckBox x:Name="TasksSelectAllCheckBox"
                                      Content="Tout sélectionner"
                                      IsThreeState="True"
                                      Click="TasksSelectAllCheckBox_Click" />
                            <CheckBox x:Name="ProModeCheckBox"
                                      Content="Pro"
                                      Margin="12 0 0 0"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding IsProfessionalMode, Mode=TwoWay}" />
                        </StackPanel>
                        <ListView x:Name="TasksList"
                                  Grid.Row="1"
                                  ItemsSource="{Binding ConfigurationTasks}"
                                  BorderThickness="0"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.Resources>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="4" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.Resources>
                            <ListView.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:ConfigurationTask}">
                                    <Grid Margin="0 4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="220" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="0">
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      VerticalAlignment="Center"
                                                      Margin="0 0 12 0" />
                                            <StackPanel Orientation="Vertical">
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           Foreground="#1F2933" />
                                                <TextBlock Text="{Binding Description}"
                                                           Foreground="#425066"
                                                           FontStyle="Italic"
                                                           Margin="0 2 0 0"
                                                           TextWrapping="Wrap"
                                                           Visibility="{Binding Description, Converter={StaticResource StringNotNullOrEmptyToVisibilityConverter}}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Status}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Foreground="#2F73DA" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </TabItem>
            <TabItem Header="A faire manuellement">
                <Border Padding="12" CornerRadius="8" Background="#F4F6FB" BorderBrush="#D0D6E2" BorderThickness="1">
                    <ListView x:Name="ManualTasksList"
                              ItemsSource="{Binding ManualTasks}"
                              BorderThickness="0"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.Resources>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="4" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.Resources>
                        <ListView.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:ManualTask}">
                                <Border Padding="8"
                                        CornerRadius="6"
                                        Background="#FFFFFFFF"
                                        BorderBrush="#D0D6E2"
                                        BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#FFFFFFFF" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                    <Setter Property="Background" Value="#FFEFF8E6" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <CheckBox IsChecked="{Binding IsCompleted, Mode=TwoWay}" VerticalAlignment="Top">
                                        <CheckBox.Content>
                                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" Foreground="#1F2933">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#1F2933" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                <Setter Property="TextDecorations" Value="Strikethrough" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </CheckBox.Content>
                                    </CheckBox>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 16 0 16">
            <Button x:Name="CancelButton"
                    Content="Annuler"
                    Width="140"
                    Height="36"
                    Margin="0 0 12 0"
                    IsEnabled="False"
                    Click="CancelButton_Click" />
            <Button x:Name="InstallButton" Content="Installer" Width="140" Height="36" Click="InstallButton_Click" />
        </StackPanel>

        <Border Grid.Row="3" Padding="12" CornerRadius="8" Background="#FFFFFF" BorderBrush="#D0D6E2" BorderThickness="1">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0 0 0 8" LastChildFill="False">
                    <TextBlock Text="Journal"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Button x:Name="CopyLogButton"
                            Content="Copier le journal"
                            Margin="12 0 0 0"
                            Padding="12 4"
                            Click="CopyLogButton_OnClick"
                            VerticalAlignment="Center" />
                </DockPanel>
                <ListBox x:Name="LogListBox"
                         ItemsSource="{Binding Logs}"
                         BorderThickness="0"
                         Background="#FF000000"
                         Foreground="#FFFFFFFF"
                         MinHeight="180"
                         Loaded="LogListBox_OnLoaded"
                         Unloaded="LogListBox_OnUnloaded" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
