<Window x:Class="SoftwareSetupApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SoftwareSetupApp"
        xmlns:models="clr-namespace:SoftwareSetupApp.Models"
        mc:Ignorable="d"
        Title="Post-installation Setup" Height="500" Width="680"
        MinWidth="620" MinHeight="420">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Vertical" Grid.Row="0" Margin="0 0 0 16">
            <TextBlock Text="Préparez votre poste en installant les applications essentielles." FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="Sélectionnez les logiciels à installer via winget puis cliquez sur &quot;Installer&quot;." Margin="0 6 0 0" />
        </StackPanel>

        <Border Grid.Row="1" Padding="12" CornerRadius="8" Background="#F4F6FB" BorderBrush="#D0D6E2" BorderThickness="1">
            <StackPanel>
                <CheckBox x:Name="SelectAllCheckBox"
                          Content="Tout sélectionner"
                          Margin="0 0 0 8"
                          IsThreeState="True"
                          Click="SelectAllCheckBox_Click" />
                <ListView x:Name="PackagesList"
                          ItemsSource="{Binding Packages}"
                          BorderThickness="0">
                    <ListView.Resources>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="4" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.Resources>
                    <ListView.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:SoftwarePackage}">
                            <Grid Margin="0 4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="180" />
                                </Grid.ColumnDefinitions>
                                <Grid Margin="0" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              Margin="0 0 12 0" />
                                    <ContentControl Grid.Column="1"
                                                    Margin="0 0 12 0"
                                                    VerticalAlignment="Center"
                                                    Content="{Binding}">
                                        <ContentControl.Style>
                                            <Style TargetType="ContentControl">
                                                <Setter Property="ContentTemplate">
                                                    <Setter.Value>
                                                        <DataTemplate>
                                                            <Border Width="32"
                                                                    Height="32"
                                                                    CornerRadius="8"
                                                                    Background="#E0E3EB"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           FontWeight="SemiBold"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="#425066" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LogoKey}" Value="vlc">
                                                        <Setter Property="ContentTemplate">
                                                            <Setter.Value>
                                                                <DataTemplate>
                                                                    <Border Width="32"
                                                                            Height="32"
                                                                            CornerRadius="8"
                                                                            Background="#FFF3E0"
                                                                            Padding="4">
                                                                        <Grid>
                                                                            <Polygon Points="16,2 27,26 5,26"
                                                                                     Fill="#FF9800" />
                                                                            <Polygon Points="16,6 24,24 8,24"
                                                                                     Fill="#FFE0B2" />
                                                                            <Rectangle Width="18"
                                                                                       Height="4"
                                                                                       RadiusX="2"
                                                                                       RadiusY="2"
                                                                                       Fill="White"
                                                                                       VerticalAlignment="Bottom"
                                                                                       Margin="0 0 0 2"
                                                                                       HorizontalAlignment="Center" />
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding LogoKey}" Value="chrome">
                                                        <Setter Property="ContentTemplate">
                                                            <Setter.Value>
                                                                <DataTemplate>
                                                                    <Grid Width="32"
                                                                          Height="32">
                                                                        <Ellipse Fill="#F44336" />
                                                                        <Path Data="M16,2 L28,28 L16,16 Z"
                                                                              Fill="#FFEB3B" />
                                                                        <Path Data="M16,2 L4,16 L16,16 Z"
                                                                              Fill="#4CAF50" />
                                                                        <Path Data="M4,16 L16,30 L16,16 Z"
                                                                              Fill="#1A73E8" />
                                                                        <Ellipse Width="18"
                                                                                 Height="18"
                                                                                 Fill="White"
                                                                                 HorizontalAlignment="Center"
                                                                                 VerticalAlignment="Center" />
                                                                        <Ellipse Width="10"
                                                                                 Height="10"
                                                                                 Fill="#1A73E8"
                                                                                 HorizontalAlignment="Center"
                                                                                 VerticalAlignment="Center" />
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding LogoKey}" Value="acrobat">
                                                        <Setter Property="ContentTemplate">
                                                            <Setter.Value>
                                                                <DataTemplate>
                                                                    <Border Width="32"
                                                                            Height="32"
                                                                            CornerRadius="8"
                                                                            Background="#D3002D"
                                                                            Padding="3">
                                                                        <Grid>
                                                                            <Path Data="M15,4 L21,26 H18 L16,19 H10 L8,26 H5 L11,8 Z"
                                                                                  Fill="White"
                                                                                  Stretch="Fill"
                                                                                  Margin="3 2 3 2" />
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ContentControl.Style>
                                    </ContentControl>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Name}"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold"
                                               Foreground="#1F2933" />
                                </Grid>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Status}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Foreground="#2F73DA" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 16 0 16">
            <Button x:Name="InstallButton" Content="Installer" Width="140" Height="36" Click="InstallButton_Click" />
        </StackPanel>

        <Border Grid.Row="3" Padding="12" CornerRadius="8" Background="#FFFFFF" BorderBrush="#D0D6E2" BorderThickness="1">
            <DockPanel>
                <TextBlock Text="Journal" FontWeight="SemiBold" DockPanel.Dock="Top" Margin="0 0 0 8" />
                <ListBox x:Name="LogListBox"
                         ItemsSource="{Binding Logs}"
                         BorderThickness="0" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
