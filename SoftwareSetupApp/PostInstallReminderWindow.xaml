<Window x:Class="SoftwareSetupApp.PostInstallReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Actions manuelles requises"
        Height="260"
        Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Certaines personnalisations doivent être appliquées manuellement :"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0 0 0 16"
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="1"
                    Margin="0 0 0 16"
                    Orientation="Vertical"
                    Spacing="8">
            <TextBlock Text="• Définissez Google Chrome comme navigateur par défaut via Paramètres > Applications > Applications par défaut."
                       TextWrapping="Wrap" />
            <TextBlock Text="• Ouvrez Chrome et ajoutez https://www.google.com dans la barre des favoris (dossier &quot;Barre de favoris&quot;)."
                       TextWrapping="Wrap" />
            <TextBlock Text="• Épinglez Google Chrome à la barre des tâches si nécessaire."
                       TextWrapping="Wrap" />
        </StackPanel>

        <Button Grid.Row="2"
                Content="J'ai compris"
                Width="120"
                Height="32"
                HorizontalAlignment="Right"
                Click="CloseButton_OnClick" />
    </Grid>
</Window>
